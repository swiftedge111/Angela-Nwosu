# Copy to .env.local (and add the same keys in your hosting dashboard).

# Smartsupp live chat. Optional: the key is already built into src/lib/site.ts.
# Set this only to use a different Smartsupp account (the bare key or the whole embed snippet both work).
NEXT_PUBLIC_SMARTSUPP_KEY=

# Optional: Smartsupp group ID (Settings → Groups) so this site's chats are routed separately
# when the same Smartsupp account serves another website. Needs the Expert or Ultimate plan.
NEXT_PUBLIC_SMARTSUPP_GROUP=

# Public site address, used for SEO links and the sitemap.
NEXT_PUBLIC_SITE_URL=https://angelanwosu.com
