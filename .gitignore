# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Raw dumps from the old WordPress site (images, videos, page HTML). Everything the
# site uses is in public/ and src/assets/; scraped/CONTENT.md, PRICES.md and
# products.json are kept.
/scraped/images/
/scraped/pages/

# local AI-assistant pointer created by create-next-app
/CLAUDE.md
